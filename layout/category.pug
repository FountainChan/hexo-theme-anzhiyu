extends includes/layout.pug

block content
  if theme.category_ui == 'index'
    include ./includes/mixins/post-ui.pug
    #recent-posts.recent-posts.category_ui
      +postUI
      include includes/pagination.pug
  else
    include ./includes/mixins/article-sort.pug
    #category
      #catalog-bar
        i.anzhiyufont.anzhiyu-icon-shapes
        #catalog-list
          .catalog-list-item
            a(href="/") 首页
          !=catalog_list("categories")
        .category-bar-next#category-bar-next(onclick="anzhiyu.scrollCategoryBarToRight()")
          i.anzhiyufont.anzhiyu-icon-angle-double-right
        a.catalog-more(href="/categories/")!= '更多'
      //- 子分类切换 tabs（参考分类页风格：边框 + 计数，无 # 符号）
      - var subcatConfig = { 'SEO教程': { parent: 'SEO教程', parentSlug: 'seo', children: [{ name: '入门教程', slug: 'basic' }, { name: '进阶教程', slug: 'advanced' }] } }
      - var tabConfig = subcatConfig[page.category]
      - if (!tabConfig) {
        - var allCats = site.categories.toArray ? site.categories.toArray() : []
        - var curCat = null
        - allCats.forEach(function(c) { if (c.name === page.category) curCat = c })
        - if (curCat && curCat.parent) {
          - var parentCat = allCats.find(function(c) { return c._id === curCat.parent })
          - if (parentCat) tabConfig = subcatConfig[parentCat.name]
        - }
      - }
      if tabConfig
        #subcategory-tabs(style="display:flex;flex-flow:row wrap;margin:0.5rem 0 0.8rem 0")
          each child in tabConfig.children
            - var isActive = page.category === child.name
            - var tabPath = '/categories/' + tabConfig.parentSlug + '/' + child.slug + '/'
            - var bgColor = isActive ? 'var(--anzhiyu-theme)' : 'transparent'
            - var txtColor = isActive ? '#fff' : 'var(--anzhiyu-fontcolor)'
            - var bdrStyle = isActive ? 'var(--style-border-none)' : 'var(--style-border-always)'
            - var countColor = isActive ? 'var(--anzhiyu-lighttext)' : 'var(--anzhiyu-fontcolor)'
            //- 从 site.categories 获取文章数
            - var count = 0
            - if (site.categories) {
              - var catArr = site.categories.toArray ? site.categories.toArray() : []
              - catArr.forEach(function(cat) { if (cat.name === child.name) count = cat.length })
            - }
            a(href=tabPath
              style="display:flex;align-items:center;padding:0.1rem 0.6rem;margin:0.25rem;border-radius:8px;border:" + bdrStyle + ";text-decoration:none;font-size:1.1rem;transition:all 0.3s;background:" + bgColor + ";color:" + txtColor
              onmouseover="this.style.background='var(--anzhiyu-theme)';this.style.color='#fff';this.style.border='var(--style-border-none)'"
              onmouseout="this.style.background='" + bgColor + "';this.style.color='" + txtColor + "';this.style.border='" + bdrStyle + "'")
              = child.name
              span.tagsPageCount(style="margin-left:6px;padding:3px 6px;background:var(--anzhiyu-secondbg);border:var(--style-border-always);border-radius:4px;font-size:0.7rem;line-height:1;color:" + countColor)
                = count
      // 标题（面包屑格式：分类 链接到 /categories/，hover 同 catalog-bar）
      - var titleHtml = '<a href="/categories/" style="color:var(--theme-color);text-decoration:none;padding:0.1rem 0.5rem;border-radius:8px;transition:all 0.3s" onmouseover="this.style.background=\'var(--anzhiyu-main)\';this.style.color=\'#fff\'" onmouseout="this.style.background=\'transparent\';this.style.color=\'var(--theme-color)\'">' + _p('page.category') + '</a>'
      - if (tabConfig && tabConfig.parent !== page.category) {
        - titleHtml += ' / <a href="/categories/' + tabConfig.parentSlug + '/" style="color:var(--theme-color);text-decoration:none;padding:0.1rem 0.5rem;border-radius:8px;transition:all 0.3s" onmouseover="this.style.background=\'var(--anzhiyu-main)\';this.style.color=\'#fff\'" onmouseout="this.style.background=\'transparent\';this.style.color=\'var(--theme-color)\'">' + tabConfig.parent + '</a>'
        - titleHtml += ' / ' + page.category
      - } else {
        - titleHtml += ' / ' + page.category
      - }
      .article-sort-title !{titleHtml}
      +articleSort(page.posts, page.current)
      include includes/pagination.pug